{
	"agent": {
		"default_model": {
			"provider": "google",
			"model": "gemini-2.5-pro"
		},
		"model_parameters": [],
		"always_allow_tool_actions": false,
		"play_sound_when_agent_done": true
	},
	"sticky_scroll": {
		"enabled": true
	},
	"vim_mode": true,
	"vim": {
		"default_mode": "normal",
		"toggle_relative_line_numbers": true,
		"cursor_shape": {
			"normal": "block",
			"insert": "underline"
		}
	},
	"tabs": {
		"close_position": "right",
		"file_icons": true,
		"git_status": true
	},
	"theme": {
		"mode": "system",
		"light": "Catppuccin Latte",
		"dark": "Catppuccin Mocha"
	},
	"buffer_font_size": 16,
	"buffer_font_weight": 400,
	"buffer_line_height": "comfortable",
	"tab_size": 4,
	"buffer_font_family": "JetBrains Mono",
	"buffer_font_features": {
		"calt": true
	},
	"ui_font_size": 16,
	"format_on_save": "on",
	"ensure_final_newline_on_save": true,
	"remove_trailing_whitespace_on_save": true,
	"show_whitespaces": "selection",
	"preferred_line_length": 100,
	"show_wrap_guides": true,
	"vertical_scroll_margin": 3,
	"scroll_beyond_last_line": "one_page",
	"cursor_blink": true,
	"project_panel": {
		"dock": "right",
		"indent_size": 16,
		"auto_reveal_entries": true,
		"auto_fold_dirs": true
	},
	"git_panel": {
		"button": true,
		"dock": "right"
	},
	"outline_panel": {
		"dock": "right",
		"button": true
	},
	"notification_panel": {
		"button": false
	},
	"terminal": {
		"button": true,
		"dock": "bottom",
		"default_height": 400,
		"detect_venv": {
			"on": {
				"directories": [".env", "env", ".venv", "venv"],
				"activate_script": "default"
			}
		},
		"blinking": "terminal_controlled",
		"alternate_scroll": "on",
		"copy_on_select": false,
		"env": {}
	},
	"collaboration_panel": {
		"button": false,
		"dock": "right"
	},
	"experimental.theme_overrides": {
		"background.appearance": "blurred",
		"background": "#11111Bf2",
		"status_bar.background": "#11111Bf2",
		"title_bar.background": "#11111Bf2",
		"elevated_surface.background": "#11111Bf2",
		"surface.background": "#11111Bf2",
		"editor.background": "#11111Bf2",
		"editor.gutter.background": "#11111B40",
		"editor.active_line_number": "#8caaee",
		"editor.indent_guide": "#8caaee1a",
		"editor.indent_guide_active": "#8caaee33",
		"hint.background": "#414559f2",
		"tab_bar.background": "#11111Bf2",
		"tab.active_background": "#8caaee20",
		"tab.inactive_background": "#11111Bf2",
		"element.selected": "#8caaee20",
		"panel.background": "#11111Bf2",
		"toolbar.background": "#11111Bf2",
		"terminal.background": "#11111Bf2",
		"scrollbar.track.background": "#11111Bf2",
		"scrollbar.track.border": "#00000000",
		"scrollbar.thumb.background": "#8caaee40",
		"ghost_element.background": "#00000000",
		"ghost_element.hover": "#8caaee10",
		"ghost_element.active": "#8caaee15",
		"ghost_element.selected": "#8caaee20",
		"drop_target.background": "#8caaee20",
		"element.hover": "#8caaee10",
		"editor.highlighted_line.background": "#8caaee25"
	},
	"toolbar": {
		"breadcrumbs": true,
		"quick_actions": true
	},
	"tab_bar": {
		"show": true,
		"show_nav_history_buttons": false
	},
	"features": {
		"edit_prediction_provider": "zed"
	},
	"hard_tabs": true,
	"auto_update": true,
	"telemetry": {
		"diagnostics": true,
		"metrics": false
	},
	"inlay_hints": {
		"enabled": true,
		"show_type_hints": true,
		"show_parameter_hints": true
	},
	"edit_predictions": {
		"disabled_globs": [".env"]
	},
	"code_actions_on_format": {},
	"git": {
		"git_gutter": "tracked_files",
		"inline_blame": {
			"enabled": true
		}
	},
	"preview_tabs": {
		"enabled": true,
		"enable_preview_from_file_finder": true
	},
	"languages": {
		"Python": {
			"language_servers": ["!basedpyright", "..."],
			"tab_size": 4,
			"formatter": "language_server",
			"format_on_save": "on",
			"preferred_line_length": 88
		},
		"JavaScript": {
			"tab_size": 2,
			"formatter": "language_server"
		},
		"TypeScript": {
			"tab_size": 2,
			"formatter": "language_server"
		},
		"Rust": {
			"tab_size": 4,
			"format_on_save": "on"
		},
		"JSON": {
			"tab_size": 2
		}
	},
	"lsp": {
		"basedpyright": {
			"settings": {
				"basedpyright.analysis": {
					"diagnosticMode": "workspace",
					"typeCheckingMode": "basic",
					"inlayHints": {
						"callArgumentNames": false,
						"variableTypes": true,
						"functionReturnTypes": true
					}
				}
			}
		}
	}
}
